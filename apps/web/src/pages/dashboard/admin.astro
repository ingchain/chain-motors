---
import MainLayout from "../../layouts/MainLayout.astro";
import AuthRoleGate from "../../components/islands/AuthRoleGate";
import AdminInventoryTable from "../../components/islands/AdminInventoryTable";
import AdminOrderBoard from "../../components/islands/AdminOrderBoard";
---

<MainLayout title="Chain Motors | Dashboard Admin">
  <AuthRoleGate requiredRole="admin" client:load />
  <section class="grid gap-6">
    <h1 class="font-display text-2xl font-semibold text-chain-100">Panel Administrador</h1>
    <AdminInventoryTable client:visible />
    <AdminOrderBoard client:visible />
  </section>
</MainLayout>
