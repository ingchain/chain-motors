---
import MainLayout from "../layouts/MainLayout.astro";
import ServiceCards from "../components/islands/ServiceCards";
---

<MainLayout title="Chain Motors | Servicios">
  <section>
    <h1 class="font-display text-2xl uppercase tracking-wider">Servicios Premium</h1>
    <p class="mt-2 text-sm text-chain-200">Astro renderiza el layout y React hidrata solo esta seccion para mejor performance.</p>
    <div class="mt-6">
      <ServiceCards client:visible />
    </div>
  </section>
</MainLayout>
