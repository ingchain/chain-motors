---
import MainLayout from "../layouts/MainLayout.astro";
import NeonCard from "../components/ui/NeonCard.astro";
---

<MainLayout title="Chain Motors | Quienes Somos">
  <section class="grid gap-4 md:grid-cols-2">
    <NeonCard>
      <h1 class="font-display text-xl uppercase tracking-wide">Quienes Somos</h1>
      <p class="mt-3 text-sm text-chain-200/90">
        Chain Motors fusiona tecnologia automotriz y experiencia digital para crear una tienda virtual de nueva generacion.
      </p>
    </NeonCard>
    <NeonCard>
      <h2 class="font-display text-xl uppercase tracking-wide">Mision</h2>
      <p class="mt-3 text-sm text-chain-200/90">
        Ofrecer motores y servicios de alto rendimiento con una UX minimalista, segura y escalable.
      </p>
    </NeonCard>
  </section>
</MainLayout>
