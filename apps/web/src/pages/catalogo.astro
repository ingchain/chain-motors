---
import MainLayout from "../layouts/MainLayout.astro";
import ProductGrid from "../components/islands/ProductGrid";
---

<MainLayout title="Chain Motors | Catalogo">
  <section>
    <h1 class="font-display text-2xl uppercase tracking-wider">Catalogo Dinamico</h1>
    <p class="mt-2 text-sm text-chain-200">Datos consumidos desde la coleccion products en MongoDB Atlas via FastAPI.</p>
    <div class="mt-6">
      <ProductGrid client:load />
    </div>
  </section>
</MainLayout>
