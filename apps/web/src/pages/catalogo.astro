---
import MainLayout from "../layouts/MainLayout.astro";
import ProductGrid from "../components/islands/ProductGrid";
---

<MainLayout title="Chain Motors | Catalogo">
  <section>
    <h1 class="font-display text-2xl font-semibold text-chain-100">Catalogo de productos</h1>
    <p class="mt-2 text-sm text-chain-300">Consulta de inventario en linea desde MongoDB Atlas via FastAPI.</p>
    <div class="mt-6">
      <ProductGrid client:idle />
    </div>
  </section>
</MainLayout>
