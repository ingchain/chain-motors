---
import MainLayout from "../layouts/MainLayout.astro";
import NeonCard from "../components/ui/NeonCard.astro";
---

<MainLayout title="Chain Motors | Inicio">
  <section class="grid gap-6 lg:grid-cols-2">
    <NeonCard>
      <h1 class="font-display text-3xl uppercase tracking-widest text-chain-100 md:text-4xl">Motores del futuro</h1>
      <p class="mt-4 text-chain-200/90">
        Tienda virtual futurista para motores, accesorios y servicios premium. Rendimiento, precision y estilo en una sola plataforma.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="rounded-md border border-chain-500 bg-chain-500/20 px-4 py-2 text-sm shadow-neon" href="/catalogo">Ver Catalogo</a>
        <a class="rounded-md border border-chain-500/70 px-4 py-2 text-sm" href="/servicios">Servicios Premium</a>
      </div>
    </NeonCard>
    <NeonCard>
      <p class="text-sm uppercase tracking-widest text-chain-300">Performance Hub</p>
      <p class="mt-3 text-sm text-chain-200/90">
        Arquitectura optimizada con Astro Islands, autenticacion JWT, MongoDB Atlas y paneles cliente/admin para gestion total.
      </p>
    </NeonCard>
  </section>
</MainLayout>
